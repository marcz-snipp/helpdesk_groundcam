<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="groundcam_reschedule_appointment_view_form" model="ir.ui.view">
        <field name="name">groundcam.reschedule.appointment.form</field>
        <field name="model">groundcam.reschedule.appointment</field>
        <field name="arch" type="xml">
            <form string="Reschedule Appointment">
                <sheet>
                    <group>
                        <field name="appointment_id" invisible="1"/>
                        <field name="scheduled_at"/>
                        <field name="duration_minutes" widget="radio"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_reschedule" type="object"
                        string="Reschedule" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

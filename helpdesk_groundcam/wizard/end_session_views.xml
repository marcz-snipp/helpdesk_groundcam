<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="groundcam_end_session_view_form" model="ir.ui.view">
        <field name="name">groundcam.end.session.form</field>
        <field name="model">groundcam.end.session</field>
        <field name="arch" type="xml">
            <form string="End Session">
                <sheet>
                    <group>
                        <field name="session_id" invisible="1"/>
                        <field name="closure_type_id"/>
                        <field name="closure_type_require_comment" invisible="1"/>
                        <label for="agent_duration_min" string="Agent duration"/>
                        <div>
                            <field name="agent_duration_min" class="oe_inline"/> min
                            <field name="agent_duration_sec" class="oe_inline"/> sec
                        </div>
                        <label for="client_duration_min" string="Client duration"/>
                        <div>
                            <field name="client_duration_min" class="oe_inline"/> min
                            <field name="client_duration_sec" class="oe_inline"/> sec
                        </div>
                        <field name="notes"
                            required="closure_type_require_comment"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_end" type="object"
                        string="End Session" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

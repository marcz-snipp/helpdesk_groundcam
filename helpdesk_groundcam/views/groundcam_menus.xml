<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Agent action & views (must be defined before menus that reference them) -->
    <record id="groundcam_agent_action" model="ir.actions.act_window">
        <field name="name">GroundCam Agents</field>
        <field name="res_model">groundcam.agent</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="groundcam_agent_view_list" model="ir.ui.view">
        <field name="name">groundcam.agent.list</field>
        <field name="model">groundcam.agent</field>
        <field name="arch" type="xml">
            <list string="GroundCam Agents">
                <field name="display_name_gc" string="Name"/>
                <field name="email"/>
                <field name="role"/>
                <field name="user_id"/>
                <field name="disabled"/>
                <field name="joined_at" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="groundcam_agent_view_form" model="ir.ui.view">
        <field name="name">groundcam.agent.form</field>
        <field name="model">groundcam.agent</field>
        <field name="arch" type="xml">
            <form string="GroundCam Agent">
                <sheet>
                    <group>
                        <group>
                            <field name="display_name_gc" string="Name"/>
                            <field name="email"/>
                            <field name="groundcam_id"/>
                            <field name="role"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="disabled"/>
                            <field name="joined_at" invisible="not joined_at"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Menus under Helpdesk > Configuration -->
    <menuitem id="menu_groundcam_root"
        name="GroundCam"
        parent="helpdesk.helpdesk_menu_config"
        sequence="60"/>

    <menuitem id="menu_groundcam_sessions"
        name="Video Sessions"
        parent="menu_groundcam_root"
        action="groundcam_session_action"
        sequence="10"/>

    <menuitem id="menu_groundcam_appointments"
        name="Video Appointments"
        parent="menu_groundcam_root"
        action="groundcam_appointment_action"
        sequence="20"/>

    <menuitem id="menu_groundcam_agents"
        name="GroundCam Agents"
        parent="menu_groundcam_root"
        action="groundcam_agent_action"
        sequence="30"
        groups="helpdesk.group_helpdesk_manager"/>
</odoo>
